<!DOCTYPE html> 

<html> 

<head> 

  <meta charset="UTF-8" /> 

  <title>Mini Game Platform</title> 

  <style> 

    body { 

      font-family: Arial, sans-serif; 

      background: #0f172a; 

      color: #e5e7eb; 

      margin: 0; 

      padding: 20px; 

    } 

    h1 { 

      margin-top: 0; 

    } 

    nav button { 

      margin-right: 8px; 

      margin-bottom: 12px; 

      padding: 6px 10px; 

      border: none; 

      border-radius: 4px; 

      background: #1d4ed8; 

      color: white; 

      cursor: pointer; 

    } 

    nav button:hover { 

      background: #2563eb; 

    } 

    input, button, textarea { 

      margin: 4px 0; 

      padding: 6px; 

      border-radius: 4px; 

      border: 1px solid #4b5563; 

    } 

    .hidden { 

      display: none; 

    } 

    .page { 

      margin-top: 10px; 

      padding: 10px; 

      background: #111827; 

      border-radius: 8px; 

    } 

  </style> 

</head> 

<body> 

  <h1>Mini Game Platform</h1> 

  <nav> 

    <button onclick="showPage('home')">Home</button> 

    <button onclick="showPage('create')">Create Game</button> 

    <button onclick="showPage('play')">Play Game</button> </nav> 

  

  <!-- Home Page --> 

  <div id="home" class="page"> 

    <h2>Welcome</h2> 

    <p> 

      This is your own mini game website. You can create a quiz and then play it. 

    </p> 

    <p> 

      Click <b>Create Game</b> to add questions, then <b>Play Game</b> to try it. 

    </p> 

  </div> 

  

  <!-- Create Game Page --> 

  <div id="create" class="page hidden"> 

    <h2>Create Game</h2> 

    <label>Game title:</label><br /> 

    <input id="gameTitle" placeholder="e.g. Math Quiz" /><br /><br /> 

  

    <h3>Add Question</h3> 

    <input id="questionText" placeholder="Question" style="width: 300px;" /><br /> 

    <input id="answerText" placeholder="Answer" style="width: 300px;" /><br /> 

    <button onclick="addQuestion()">Add Question</button> 

  

    <h3>Questions</h3> 

    <ul id="questionList"></ul> 

  

    <button onclick="saveGame()">Save Game</button> 

    <p id="saveMessage"></p> 

  </div> 

  

  <!-- Play Game Page --> 

  <div id="play" class="page hidden"> 

    <h2>Play Game</h2> 

    <p id="playInfo"></p> 

    <div id="quizArea" class="hidden"> 

      <h3 id="currentQuestion"></h3> 

      <input id="playerAnswer" placeholder="Type your answer" /> 

      <button onclick="submitAnswer()">Submit</button> 

      <p id="feedback"></p> 

      <p id="progress"></p> 

    </div> 

    <button id="startButton" onclick="startGame()" class="hidden">Start Game</button> 

  </div> 

  

  <script> 

    // Simple in-memory game data 

    let game = { 

      title: "", 

      questions: [] 

    }; 

    let currentIndex = 0; 

    let score = 0; 

  

    function showPage(pageId) { 

      document.getElementById("home").classList.add("hidden"); 

      document.getElementById("create").classList.add("hidden"); 

      document.getElementById("play").classList.add("hidden"); 

      document.getElementById(pageId).classList.remove("hidden"); 

    } 

  

    function addQuestion() { 

      const qInput = document.getElementById("questionText"); 

      const aInput = document.getElementById("answerText"); 

      const q = qInput.value.trim(); 

      const a = aInput.value.trim(); 

      if (!q || !a) { 

        alert("Please enter both a question and an answer."); 

        return; 

      } 

      game.questions.push({ q, a }); 

      qInput.value = ""; 

      aInput.value = ""; 

      renderQuestions(); 

    } 

  

    function renderQuestions() { 

      const list = document.getElementById("questionList"); 

      list.innerHTML = ""; 

      game.questions.forEach((item, index) => { 

        const li = document.createElement("li"); 

        li.textContent = (index + 1) + ". " + item.q + " = " + item.a; 

        list.appendChild(li); 

      }); 

    } 

  

    function saveGame() { 

      const titleInput = document.getElementById("gameTitle"); 

      const title = titleInput.value.trim(); 

      if (!title) { 

        alert("Please enter a game title."); 

        return; 

      } 

      if (game.questions.length === 0) { 

        alert("Please add at least one question."); 

        return; 

      } 

      game.title = title; 

      document.getElementById("saveMessage").textContent = 

        "Game saved! Go to 'Play Game' to try it."; 

    } 

  

    function startGame() { 

      if (!game.title || game.questions.length === 0) { 

        alert("You need to create and save a game first."); 

        return; 

      } 

      currentIndex = 0; 

      score = 0; 

      document.getElementById("feedback").textContent = ""; 

      document.getElementById("quizArea").classList.remove("hidden"); 

      document.getElementById("startButton").classList.add("hidden"); 

      showQuestion(); 

    } 

  

    function showQuestion() { 

      const qData = game.questions[currentIndex]; 

      document.getElementById("currentQuestion").textContent = qData.q; 

      document.getElementById("playerAnswer").value = ""; 

      document.getElementById("progress").textContent = 

        "Question " + (currentIndex + 1) + " of " + game.questions.length; 

    } 

  

    function submitAnswer() { 

      const answerInput = document.getElementById("playerAnswer"); 

      const userAnswer = answerInput.value.trim(); 

      const correctAnswer = game.questions[currentIndex].a.trim(); 

  

      if (!userAnswer) { 

        alert("Please type an answer."); 

        return; 

      } 

  

      if (userAnswer.toLowerCase() === correctAnswer.toLowerCase()) { 

        score++; 

        document.getElementById("feedback").textContent = "Correct!"; 

      } else { 

        document.getElementById("feedback").textContent = 

          "Wrong! Correct answer: " + correctAnswer; 

      } 

  

      currentIndex++; 

      if (currentIndex >= game.questions.length) { 

        document.getElementById("progress").textContent = 

          "Game over! Your score: " + score + " / " + game.questions.length; 

        document.getElementById("quizArea").classList.add("hidden"); 

        document.getElementById("startButton").classList.remove("hidden"); 

      } else { 

        showQuestion(); 

      } 

    } 

  

    // When Play page is shown, update info 

    function updatePlayInfo() { 

      const info = document.getElementById("playInfo"); 

      if (!game.title || game.questions.length === 0) { 

        info.textContent = 

          "No game saved yet. Go to 'Create Game' to make one."; 

        document.getElementById("startButton").classList.add("hidden"); 

        document.getElementById("quizArea").classList.add("hidden"); 

      } else { 

        info.textContent = 

          "Game: " + game.title + " (" + game.questions.length + " questions)"; 

        document.getElementById("startButton").classList.remove("hidden"); 

      } 

    } 

  

    // Hook into page switching to update Play info 

    const originalShowPage = showPage; 

    showPage = function (pageId) { 

      originalShowPage(pageId); 

      if (pageId === "play") { 

        updatePlayInfo(); 

      } 

    }; 

  </script> 

</body> 

</html> 

 
