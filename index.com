<!DOCTYPE html><html><body style="margin:0;background:#222;color:#fff;font-family:sans-serif;"><div style="padding:4px;background:#111;display:flex;gap:10px;align-items:center;"><span id="money">Money: 100</span><span id="lives">Lives: 20</span><span id="wave">Wave: 0</span><button id="basicBtn">Basic (50)</button><button id="sniperBtn">Sniper (80)</button><span style="font-size:12px;">Click on map to place tower</span></div><canvas id="game" width="800" height="560"></canvas><script>const c=document.getElementById("game"),x=c.getContext("2d");let money=100,lives=20,wave=0,placingType="basic";document.getElementById("basicBtn").onclick=()=>placingType="basic";document.getElementById("sniperBtn").onclick=()=>placingType="sniper";const path=[{x:0,y:260},{x:200,y:260},{x:200,y:100},{x:500,y:100},{x:500,y:400},{x:800,y:400}];class Enemy{constructor(type,speed,hp,reward){this.type=type;this.speed=speed;this.maxHp=hp;this.hp=hp;this.reward=reward;this.seg=0;this.x=path[0].x;this.y=path[0].y;}update(){if(this.seg>=path.length-1)return;let a=path[this.seg],b=path[this.seg+1],dx=b.x-a.x,dy=b.y-a.y,len=Math.hypot(dx,dy);if(len===0)return;let vx=dx/len*this.speed,vy=dy/len*this.speed;this.x+=vx;this.y+=vy;let pd=Math.hypot(this.x-a.x,this.y-a.y);if(pd>=len)this.seg++;if(this.seg>=path.length-1){lives--;this.hp=0;}}draw(){let col=this.type==="fast"?"orange":this.type==="tank"?"purple":"red";x.fillStyle=col;x.beginPath();x.arc(this.x,this.y,10,0,Math.PI*2);x.fill();x.fillStyle="black";x.fillRect(this.x-12,this.y-16,24,4);x.fillStyle="lime";x.fillRect(this.x-12,this.y-16,24*(this.hp/this.maxHp),4);}}class Tower{constructor(x,y,type){this.x=x;this.y=y;this.type=type;this.range=type==="sniper"?220:140;this.fireRate=type==="sniper"?70:30;this.damage=type==="sniper"?40:15;this.cool=0;this.level=1;}update(){if(this.cool>0){this.cool--;return;}let target=null,td=1e9;for(let e of enemies){if(e.hp<=0)continue;let d=Math.hypot(e.x-this.x,e.y-this.y);if(d<this.range&&d<td){td=d;target=e;}}if(target){projectiles.push(new Projectile(this,target));this.cool=this.fireRate;}}draw(){x.fillStyle=this.type==="sniper"?"#0ff":"#0af";x.beginPath();x.arc(this.x,this.y,12,0,Math.PI*2);x.fill();x.fillStyle="white";x.fillText("L"+this.level,this.x-8,this.y+4);}tryUpgrade(){let cost=this.level*40;if(money>=cost&&this.level<4){money-=cost;this.level++;this.damage+=10;this.range+=10;}}}class Projectile{constructor(t,e){this.x=t.x;this.y=t.y;this.e=e;this.speed=6;this.dmg=t.damage;}update(){if(this.e.hp<=0)return;let dx=this.e.x-this.x,dy=this.e.y-this.y,d=Math.hypot(dx,dy);if(d<6){this.e.hp-=this.dmg;return this.dead=true;}this.x+=dx/d*this.speed;this.y+=dy/d*this.speed;}draw(){x.fillStyle="yellow";x.beginPath();x.arc(this.x,this.y,4,0,Math.PI*2);x.fill();}}let enemies=[],towers=[],projectiles=[],waveCd=0;function spawnWave(){wave++;let count=4+wave*2;for(let i=0;i<count;i++){setTimeout(()=>{let r=Math.random();if(r<0.2)enemies.push(new Enemy("fast",2+wave*0.1,50+wave*5,15));else if(r>0.8)enemies.push(new Enemy("tank",0.7+wave*0.05,200+wave*20,40));else enemies.push(new Enemy("normal",1+wave*0.08,100+wave*10,25));},i*400);}}c.addEventListener("click",e=>{let r=c.getBoundingClientRect(),mx=e.clientX-r.left,my=e.clientY-r.top;if(my<0)return;let cost=placingType==="sniper"?80:50;if(money<cost)return;for(let p of path){if(Math.hypot(mx-p.x,my-p.y)<40)return;}money-=cost;towers.push(new Tower(mx,my,placingType));});c.addEventListener("contextmenu",e=>{e.preventDefault();let r=c.getBoundingClientRect(),mx=e.clientX-r.left,my=e.clientY-r.top;for(let t of towers){if(Math.hypot(mx-t.x,my-t.y)<15){t.tryUpgrade();break;}}});function update(){if(enemies.length===0&&waveCd<=0)waveCd=90;if(waveCd===1)spawnWave();if(waveCd>0)waveCd--;for(let e of enemies)e.update();for(let t of towers)t.update();for(let p of projectiles)p.update();enemies=enemies.filter(e=>e.hp>0);projectiles=projectiles.filter(p=>!p.dead);if(lives<=0){alert("Game Over! Final wave: "+wave);lives=20;money=100;wave=0;enemies=[];towers=[];projectiles=[];waveCd=0;}}function draw(){x.fillStyle="#333";x.fillRect(0,0,c.width,c.height);x.strokeStyle="#555";x.lineWidth=24;x.lineCap="round";x.beginPath();x.moveTo(path[0].x,path[0].y);for(let i=1;i<path.length;i++)x.lineTo(path[i].x,path[i].y);x.stroke();x.fillStyle="#888";x.font="14px sans-serif";x.fillText("Right-click tower to upgrade",580,20);for(let e of enemies)e.draw();for(let t of towers)t.draw();for(let p of projectiles)p.draw();document.getElementById("money").textContent="Money: "+money;document.getElementById("lives").textContent="Lives: "+lives;document.getElementById("wave").textContent="Wave: "+wave;}function loop(){update();draw();requestAnimationFrame(loop);}loop();</script></body></html>
