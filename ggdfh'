<!DOCTYPE html><html><body><canvas id="game" width="800" height="600"></canvas><script>const canvas=document.getElementById("game");const ctx=canvas.getContext("2d");class Enemy{constructor(){this.x=0;this.y=300;this.speed=1;this.health=100;}update(){this.x+=this.speed;}draw(){ctx.fillStyle="red";ctx.fillRect(this.x,this.y,20,20);}}class Tower{constructor(x,y){this.x=x;this.y=y;this.range=150;this.fireRate=30;this.cooldown=0;}update(){if(this.cooldown>0){this.cooldown--;return;}for(let e of enemies){let dx=e.x-this.x,dy=e.y-this.y,dist=Math.hypot(dx,dy);if(dist<this.range){projectiles.push(new Projectile(this.x,this.y,e));this.cooldown=this.fireRate;break;}}}draw(){ctx.fillStyle="blue";ctx.fillRect(this.x-10,this.y-10,20,20);}}class Projectile{constructor(x,y,target){this.x=x;this.y=y;this.target=target;this.speed=4;}update(){let dx=this.target.x-this.x,dy=this.target.y-this.y,dist=Math.hypot(dx,dy);this.x+=(dx/dist)*this.speed;this.y+=(dy/dist)*this.speed;if(dist<5){this.target.health-=20;}}draw(){ctx.fillStyle="yellow";ctx.beginPath();ctx.arc(this.x,this.y,5,0,Math.PI*2);ctx.fill();}}let enemies=[new Enemy()];let towers=[new Tower(200,300)];let projectiles=[];function update(){enemies.forEach(e=>e.update());towers.forEach(t=>t.update());projectiles.forEach(p=>p.update());enemies=enemies.filter(e=>e.health>0);}function draw(){ctx.clearRect(0,0,canvas.width,canvas.height);enemies.forEach(e=>e.draw());towers.forEach(t=>t.draw());projectiles.forEach(p=>p.draw());}function gameLoop(){update();draw();requestAnimationFrame(gameLoop);}gameLoop();</script></body></html>
